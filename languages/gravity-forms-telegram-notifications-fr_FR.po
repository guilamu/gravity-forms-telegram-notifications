#: class-gf-telegram.php:1017
msgid "Name"
msgstr "Nom"

#: includes/class-gf-telegram-api.php:172
#: includes/class-gf-telegram-api.php:199
#: includes/class-gf-telegram-api.php:225
msgid "No Telegram chat ID was provided."
msgstr "Aucun ID de discussion Telegram n’a été fourni."

#: class-gf-telegram.php:255 class-gf-telegram.php:558
msgid "No chats found yet. Message your bot, or add it to a group, then try again."
msgstr "Aucune discussion trouvée pour l’instant. Écrivez à votre bot, ou ajoutez-le à un groupe, puis réessayez."

#: includes/class-gf-telegram-formatter.php:87
msgid "None (plain text)"
msgstr "Aucune (texte brut)"

#: class-gf-telegram.php:340
msgid "One chat ID or public @username per line. Feeds that do not name their own recipient are sent here."
msgstr "Un ID de discussion ou un @identifiant public par ligne. Les flux qui n’indiquent pas leur propre destinataire écrivent ici."

#. translators: 1: Opening anchor tag for BotFather. 2: Closing anchor tag. 3: The /newbot command, wrapped in a code tag.
#: class-gf-telegram.php:394
msgid "Open %1$s@BotFather%2$s in Telegram, send %3$s and follow the prompts, then paste the token it gives you below."
msgstr "Ouvrez %1$s@BotFather%2$s dans Telegram, envoyez %3$s et suivez les instructions, puis collez ci-dessous le jeton qu’il vous communique."

#: class-gf-telegram.php:800
msgid "Optional. One button per line, written as Label | https://example.com"
msgstr "Facultatif. Un bouton par ligne, sous la forme Libellé | https://exemple.com"

#: class-gf-telegram.php:851
msgid "Optional. Posts into a specific topic of a forum group."
msgstr "Facultatif. Publie dans un sujet précis d’un groupe forum."

#: class-gf-telegram.php:814
msgid "Options"
msgstr "Options"

#: class-gf-telegram.php:837 class-gf-telegram.php:840
msgid "Prevent forwarding and saving"
msgstr "Empêcher le transfert et l’enregistrement"

#: class-gf-telegram.php:841
msgid "Recipients cannot forward or save the message. Useful when submissions contain personal data."
msgstr "Les destinataires ne peuvent ni transférer ni enregistrer le message. Utile lorsque les soumissions contiennent des données personnelles."

#: includes/class-github-updater.php:642
msgid "Requires Gravity Forms:"
msgstr "Nécessite Gravity Forms :"

#: class-gf-telegram.php:539 class-gf-telegram.php:642
msgid "Save a valid bot token first."
msgstr "Enregistrez d’abord un jeton de bot valide."

#: class-gf-telegram.php:458
msgid "Save your token first. Telegram only tells a bot about chats it has already heard from, so message the bot or add it to your group before searching."
msgstr "Enregistrez d’abord votre jeton. Telegram n’informe un bot que des discussions dont il a déjà reçu un message : écrivez au bot ou ajoutez-le à votre groupe avant de lancer la recherche."

#: class-gf-telegram.php:909 class-gf-telegram.php:914
msgid "Send Files From"
msgstr "Envoyer les fichiers depuis"

#: class-gf-telegram.php:755 class-gf-telegram.php:761
#: class-gf-telegram.php:1018
msgid "Send To"
msgstr "Envoyer à"

#: class-gf-telegram.php:252 class-gf-telegram.php:454
msgid "Send a test message"
msgstr "Envoyer un message de test"

#: class-gf-telegram.php:828 class-gf-telegram.php:831
msgid "Send silently"
msgstr "Envoyer en silence"

#: class-gf-telegram.php:190
msgid "Send the Telegram notification only when a payment is received."
msgstr "N’envoyer la notification Telegram que lorsqu’un paiement est reçu."

#: class-gf-telegram.php:858
msgid "Send the notification if"
msgstr "Envoyer la notification si"

#: class-gf-telegram.php:934
msgid "Sends JPEG, PNG, GIF and WebP uploads as photos, so they preview in the chat. Telegram recompresses photos, so the original file is not preserved; leave this off when the exact file matters."
msgstr "Envoie les fichiers JPEG, PNG, GIF et WebP en tant que photos, afin qu’ils s’affichent directement dans la discussion. Telegram recompresse les photos : le fichier d’origine n’est pas conservé ; laissez cette option désactivée si le fichier exact importe."

#. Description of the plugin
msgid "Sends a Telegram message to a chat, group, channel or forum topic when a Gravity Form is submitted."
msgstr "Envoie un message Telegram dans une discussion, un groupe, un canal ou un sujet de forum lors de la soumission d’un formulaire Gravity Forms."

#: class-gf-telegram.php:933
msgid "Show images inline"
msgstr "Afficher les images en aperçu"

#: class-gf-telegram.php:930
msgid "Show images inline instead of as files"
msgstr "Afficher les images en aperçu plutôt que sous forme de fichiers"

#: class-gf-telegram.php:823
msgid "Stops Telegram expanding the first link in the message into a preview card."
msgstr "Empêche Telegram de transformer le premier lien du message en carte d’aperçu."

#: class-gf-telegram.php:356
msgid "Telegram Bot Connection"
msgstr "Connexion au bot Telegram"

#: class-gf-telegram.php:739
msgid "Telegram Feed Settings"
msgstr "Réglages du flux Telegram"

#. translators: %s: A comma separated list of chat IDs and the resulting message IDs.
#: class-gf-telegram.php:1738
msgid "Telegram notification sent to: %s."
msgstr "Notification Telegram envoyée à : %s."

#. translators: %s: A list of chat IDs.
#: class-gf-telegram.php:695
msgid "Test message sent to: %s"
msgstr "Message de test envoyé à : %s"

#. translators: %d: The HTTP response code.
#: includes/class-gf-telegram-api.php:338
msgid "The API returned an unexpected response (HTTP %d)."
msgstr "L’API a renvoyé une réponse inattendue (HTTP %d)."

#: class-gf-telegram.php:762
msgid "The chat, group or channel this feed posts to. Choose Custom to enter a chat ID directly, which accepts merge tags so the recipient can come from the submission itself."
msgstr "La discussion, le groupe ou le canal dans lequel ce flux publie. Choisissez Personnalisé pour saisir directement un ID de discussion ; ce champ accepte les balises de fusion, le destinataire peut donc provenir de la soumission elle-même."

#. translators: %s: The file name.
#: includes/class-gf-telegram-api.php:404
#: includes/class-gf-telegram-api.php:418
msgid "The file %s could not be read."
msgstr "Le fichier %s n’a pas pu être lu."

#: class-gf-telegram.php:832
msgid "The message arrives without a notification sound."
msgstr "Le message arrive sans son de notification."

#: includes/class-gf-telegram-api.php:291
msgid "The message could not be encoded for sending."
msgstr "Le message n’a pas pu être encodé pour l’envoi."

#: includes/class-gf-telegram-api.php:176
msgid "The message is empty."
msgstr "Le message est vide."

#. translators: 1: The {all_fields} merge tag. 2: The message length limit.
#: class-gf-telegram.php:776
msgid "The message to send. Insert submitted values with merge tags; %1$s expands to the whole submission. Messages longer than %2$d characters are split into several."
msgstr "Le message à envoyer. Insérez les valeurs soumises à l’aide des balises de fusion ; %1$s reprend l’intégralité de la soumission. Les messages de plus de %2$d caractères sont scindés en plusieurs."

#: class-gf-telegram.php:253
msgid "The request failed. Check the Gravity Forms log for details."
msgstr "La requête a échoué. Consultez le journal de Gravity Forms pour en savoir plus."

#: class-gf-telegram.php:254
msgid "The request was rejected before it reached the add-on. Reload the page and try again."
msgstr "La requête a été rejetée avant d’atteindre l’extension. Rechargez la page et réessayez."

#: class-gf-telegram.php:325
msgid "The token @BotFather gave you, in the form 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ."
msgstr "Le jeton fourni par @BotFather, de la forme 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ."

#. translators: %s: The GF_TELEGRAM_BOT_TOKEN constant name, wrapped in a code tag.
#: class-gf-telegram.php:403
msgid "The token is currently being read from the %s constant, so it cannot be edited here."
msgstr "Le jeton est actuellement lu depuis la constante %s : il ne peut donc pas être modifié ici."

#. translators: %s: The URL currently registered as the bot's webhook.
#: class-gf-telegram.php:595
msgid "The webhook currently points at %s."
msgstr "Le webhook pointe actuellement vers %s."

#: class-gf-telegram.php:588
msgid "This bot has a webhook registered, so Telegram will not hand over its recent messages. Another plugin on this site is most likely using the same bot. Either give this site its own bot, or enter the chat ID by hand."
msgstr "Un webhook est enregistré pour ce bot : Telegram ne transmettra donc pas ses messages récents. Une autre extension de ce site utilise très probablement le même bot. Attribuez un bot dédié à ce site, ou saisissez l’ID de discussion à la main."

#: class-gf-telegram.php:848
msgid "Topic ID"
msgstr "ID du sujet"

#: class-gf-telegram.php:495
msgid "Type"
msgstr "Type"

#: includes/class-github-updater.php:883
msgid "Unable to rename the update folder. Please retry or update manually."
msgstr "Impossible de renommer le dossier de mise à jour. Réessayez ou effectuez la mise à jour manuellement."

#. translators: %s: A comma separated list of chat IDs and the reason each failed.
#: class-gf-telegram.php:1717
msgid "Unable to send the Telegram notification to: %s."
msgstr "Impossible d’envoyer la notification Telegram à : %s."

#: class-gf-telegram.php:1588
msgid "Unable to send the notification: no recipient is configured."
msgstr "Impossible d’envoyer la notification : aucun destinataire n’est configuré."

#: class-gf-telegram.php:1580
msgid "Unable to send the notification: the bot token is missing or invalid."
msgstr "Impossible d’envoyer la notification : le jeton du bot est manquant ou invalide."

#: class-gf-telegram.php:1596
msgid "Unable to send the notification: the message is empty once merge tags are replaced."
msgstr "Impossible d’envoyer la notification : le message est vide une fois les balises de fusion remplacées."

#: class-gf-telegram.php:1635
msgid "Unable to send the notification: the message is empty."
msgstr "Impossible d’envoyer la notification : le message est vide."

#: class-gf-telegram.php:905
msgid "Uploaded files are sent as separate messages, after the notification itself."
msgstr "Les fichiers envoyés sont transmis dans des messages distincts, après la notification elle-même."

#: gravity-forms-telegram-notifications.php:151
msgid "View details"
msgstr "Voir les détails"

#: class-gf-telegram.php:862
msgid "When conditional logic is enabled, the notification is only sent when the condition is met. When disabled, every submission sends one."
msgstr "Lorsque la logique conditionnelle est activée, la notification n’est envoyée que si la condition est remplie. Lorsqu’elle est désactivée, chaque soumission en déclenche une."

#: class-gf-telegram.php:250
msgid "Working…"
msgstr "En cours…"

#: class-gf-telegram.php:525
msgid "You are not allowed to do that."
msgstr "Vous n’avez pas l’autorisation d’effectuer cette action."

#: gravity-forms-telegram-notifications.php:158
msgid "🐛 Report a Bug"
msgstr "🐛 Signaler un bug"

#: gravity-forms-telegram-notifications.php:163
